// Generated by CMake from cmake/version.rc.in. Shows the mod's version in the DLL's file properties.
#include <winres.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "NLS-04"
            VALUE "FileDescription", "MirrorMod, a mirror mode for HITMAN: World of Assassination"
            VALUE "FileVersion", "@MIRRORMOD_VERSION_FULL@"
            VALUE "InternalName", "MirrorMod"
            VALUE "LegalCopyright", "Copyright (C) 2026 NLS-04, GPL-3.0-or-later"
            VALUE "OriginalFilename", "MirrorMod.dll"
            VALUE "ProductName", "MirrorMod"
            VALUE "ProductVersion", "@MIRRORMOD_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
